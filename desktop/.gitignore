# ---------------------------------------------------------------------------
# NSE Quant Engine — desktop app ignore rules
# (The repository root .gitignore is managed by Lovable and covers Node/web
#  artifacts. This file covers everything Python + engine runtime.)
# ---------------------------------------------------------------------------

# Python caches / compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Test + coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Credentials / environment
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
*~

# ---------------------------------------------------------------------------
# Runtime data caches (LOCAL EVIDENCE — keep on disk, never publish)
# ---------------------------------------------------------------------------
nse_quant_engine/data/
!nse_quant_engine/data/.gitkeep
!nse_quant_engine/data/news_alias_overrides.csv

# ---------------------------------------------------------------------------
# Runtime engine outputs: scores, validation history, dashboards, evidence
# ---------------------------------------------------------------------------
nse_quant_engine/output/
!nse_quant_engine/output/.gitkeep

# Generated dashboards anywhere under the engine
**/dashboard_*.html

# Manual backup files produced by the engine's CSV editors
nse_quant_engine/*_backup_*.csv

# Locally generated logs / working lists
nse_quant_engine/missing_ter_list.txt
nse_quant_engine/core/data/fallback_source_log.csv
