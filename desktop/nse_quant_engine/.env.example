# NSE Quant Engine — optional environment settings
# Copy to `.env` and fill in only what you need. `.env` is git-ignored.
# The engine runs fully without any of these; they only tune optional fetchers.

# Optional: override the HTTP User-Agent used when calling public NSE endpoints.
# NSE_USER_AGENT=Mozilla/5.0 (compatible; nse-quant-engine/4.8)

# Optional: request timeout in seconds for optional data fetchers.
# FETCH_TIMEOUT_SECONDS=20

# Optional: force offscreen Qt rendering (used by CI / headless runs).
# QT_QPA_PLATFORM=offscreen
